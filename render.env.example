# Environment variables for the Broom Broom web service on Render.
# Copy this file to .env.render (git-ignored), fill in the values, then in Render:
#   your service > Environment > Add from .env  (paste or upload .env.render)
# Never commit the filled-in copy.

# MongoDB Atlas connection string: Atlas > your cluster > Connect > Drivers.
# Replace <user> and <password> with the database user you created (not your Atlas login).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=broombroom

# Database name inside the cluster (created automatically on first start).
MONGODB_DB=broombroom

# The first admin account, created on the very first start only (when the database has no accounts yet).
# Use a real mailbox you control. The password needs 12+ characters; change it in Settings after signing in.
ADMIN_EMAIL=broombroombookingservices@gmail.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Node version Render should use.
NODE_VERSION=22

# Email (document re-submission requests). Render's free plan blocks SMTP, so mail goes through Brevo's API.
# Brevo > Senders, Domains & Dedicated IPs > add and verify the sender address; then SMTP & API > API Keys > Generate.
# Without BREVO_API_KEY, emails are not sent (they are only logged).
BREVO_API_KEY=xkeysib-your-key
MAIL_FROM=broombroombookingservices@gmail.com
MAIL_FROM_NAME=Broom Broom

# Optional: where Help-page messages go (default broombroombookingservices@gmail.com).
# SUPPORT_EMAIL=broombroombookingservices@gmail.com

# Optional: "Continue with Google" for clients. The Web client ID from Google Cloud Console (see README).
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# The client site's address, used for links in emails.
APP_URL=https://broombroom.onrender.com
