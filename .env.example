# Local development settings. Copy this file to .env.local (git-ignored) and fill it in.
# Production settings live on Render instead (see render.env.example).

# The admin account created on the first start (when the database has no accounts yet).
# Use a mailbox you control; the password needs 12+ characters. Change it in Settings after signing in.
ADMIN_EMAIL=broombroombookingservices@gmail.com
ADMIN_PASSWORD=

# Database. Leave empty to use a private local MongoDB in server/data/mongo (started automatically).
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Email through Brevo (optional in development: without a key, emails are saved to server/data/outbox/).
# BREVO_API_KEY=
# MAIL_FROM=broombroombookingservices@gmail.com

# "Continue with Google" for clients (optional). Add http://localhost:3000 to the client ID's JavaScript origins.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Portal URLs (optional). By default all three portals share one address: /?portal=agent and /?portal=admin.
# Set these only to put the portals on separate subdomains.
# VITE_BUYER_URL="https://example.com"
# VITE_AGENT_URL="https://agent.example.com"
# VITE_ADMIN_URL="https://admin.example.com"
